# Adresa site-ului WordPress existent (fără / la final)
# Exemplu: https://exemplu.ro
WORDPRESS_URL=

# Numele magazinului, afișat în antet și în titluri (opțional)
NEXT_PUBLIC_SITE_NAME=Filler Store

# ---- Poze pe CDN (Cloudinary) ----
# Din Cloudinary → Dashboard → „API Environment variable". Folosit DOAR de
# scriptul de urcare (npm run upload-media), niciodată în browser.
CLOUDINARY_URL=

# Numele cloudului, singurul lucru de care are nevoie site-ul ca să afișeze
# pozele de pe CDN. Ex: dxxxxxxxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Adresa publică a site-ului (canonical, sitemap, date structurate)
NEXT_PUBLIC_SITE_URL=https://fillerstore.ro
